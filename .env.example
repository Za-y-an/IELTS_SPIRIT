# ==============================================================================
# IELTS Spirit - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini Configuration
# ------------------------------------------------------------------------------
# Required for gemini-embedding-001 vector embeddings (3072 dimensions) and LLM inference.
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# ------------------------------------------------------------------------------
# Qdrant Vector Database
# ------------------------------------------------------------------------------
# Local vs Cloud Usage:
# - Local (In-Memory): Leave QDRANT_URL blank. The application will automatically
#   use an in-memory instance: `QdrantClient(location=":memory:")`.
# - Cloud / Self-Hosted: Provide the full endpoint URL, e.g.
#   QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
#   and supply QDRANT_API_KEY if authentication is enabled.
QDRANT_URL=
QDRANT_API_KEY=

# Collection name for IELTS document embeddings
QDRANT_COLLECTION_NAME=ielts_knowledge

# ------------------------------------------------------------------------------
# Supabase PostgreSQL (Async with asyncpg)
# ------------------------------------------------------------------------------
# IMPORTANT NOTE ON SUPABASE CONNECTION STRINGS:
# Supabase's dashboard gives you a sync-style string:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# To use it with SQLAlchemy's async engine (asyncpg):
#   1. Change scheme: 'postgresql://' -> 'postgresql+asyncpg://'
#   2. Percent-encode special characters in password:
#      e.g., '@' -> '%40', '#' -> '%23', '=' -> '%3D'
#   3. Append '?ssl=require' for encrypted transport
#
# Example (Transaction Pooler - port 6543):
# SUPABASE_DB_URL=postgresql+asyncpg://postgres.wrhciohsilmmtqghvuwy:password%40123@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?ssl=require
SUPABASE_DB_URL=postgresql+asyncpg://postgres.your-project-ref:your_encoded_password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?ssl=require
